{% extends "layouts/base.njk" %}
{% set pageTitle = title %}

{% block content %}
<div class="container garment-page">
    {% include "partials/header.njk" %}

    <a href="/" class="back-link">← Back to Collection</a>

    <div class="garment-hero">
        <img src="{{ heroImage }}" alt="{{ title }} - {{ subtitle }}" class="garment-image">
        <span class="garment-badge">{{ badge }}</span>
    </div>

    <div class="garment-title">
        <h1>{{ title }}</h1>
        <p class="subtitle">{{ subtitle }}</p>
    </div>

    {% include "partials/stats.njk" %}
    {% include "partials/timeline.njk" %}
    {% include "partials/materials.njk" %}
    {% include "partials/embellishments.njk" %}
    {% include "partials/certificate.njk" %}
    {% include "partials/cta.njk" %}

    {% include "partials/footer.njk" %}
</div>

<script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
<script>
    var qrContainer = document.getElementById("qr-code");
    if (qrContainer) {
        new QRCode(qrContainer, {
            text: window.location.href,
            width: 150,
            height: 150,
            colorDark: "#4A7A94",
            colorLight: "#FFFFFF",
            correctLevel: QRCode.CorrectLevel.H
        });
    }
</script>
{% endblock %}
